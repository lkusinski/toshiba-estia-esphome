# Secrets for toshiba-estia-r410a.yaml

# Wi-Fi credentials
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# ESPHome API encryption key (32 bytes base64, generate with: openssl rand -base64 32)
api_key: "CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"

# OTA update password
esphome_ota_password: "CHANGE_ME_OTA_PASSWORD"

# Fallback hotspot password
esphome_ap_password: "CHANGE_ME_AP_PASSWORD"
